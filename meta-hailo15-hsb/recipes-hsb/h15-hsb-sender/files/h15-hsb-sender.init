#!/bin/sh
### BEGIN INIT INFO
# Provides:          h15-hsb-sender
# Required-Start:    $remote_fs $syslog $network
# Required-Stop:     $remote_fs $syslog
# Default-Start:     5
# Default-Stop:      0 1 6
# Short-Description: Hailo-15 HSB sender
# Description:       Streams NV12 video over Holoscan Sensor Bridge and publishes
#                    object detections over ZMQ. Restarts the sender if it exits.
### END INIT INFO

DAEMON=/usr/bin/h15-hsb-sender
MAKE_CONFIG=/usr/bin/h15-hsb-make-config
PIDFILE=/var/run/h15-hsb-sender.pid
LOG_TAG=h15-hsb-sender
RESPAWN_DELAY=2
STOP_TIMEOUT=10

HSB_SENDER_ENABLED=1
HSB_INTERFACE=eth0
HSB_MAKE_CONFIG_OPTS=""
HSB_SENDER_OPTS=""
[ -f /etc/default/h15-hsb-sender ] && . /etc/default/h15-hsb-sender

. /etc/init.d/functions

# HSB enumeration (BOOTP) goes to the subnet broadcast address, and an interface
# configured without one (for example by settings swupdate carried over) has none.
ensure_broadcast() {
    address=$(ip -o -4 addr show dev "$HSB_INTERFACE" | awk '{ print $4; exit }')
    [ -n "$address" ] || return 0
    ip -o -4 addr show dev "$HSB_INTERFACE" | grep -q " brd " && return 0
    prefix_length=${address#*/}
    set -- $(echo "${address%/*}" | tr . ' ')
    ip_value=$((($1 << 24) | ($2 << 16) | ($3 << 8) | $4))
    broadcast_value=$((ip_value | ((1 << (32 - prefix_length)) - 1)))
    broadcast=$(((broadcast_value >> 24) & 255)).$(((broadcast_value >> 16) & 255))
    broadcast=$broadcast.$(((broadcast_value >> 8) & 255)).$((broadcast_value & 255))
    echo "Setting $HSB_INTERFACE broadcast address to $broadcast"
    ifconfig "$HSB_INTERFACE" broadcast "$broadcast"
}

is_running() {
    [ -f $PIDFILE ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null
}

wait_for_sender_exit() {
    remaining=$STOP_TIMEOUT
    while pidof h15-hsb-sender >/dev/null; do
        [ $remaining -eq 0 ] && return 1
        sleep 1
        remaining=$((remaining - 1))
    done
}

start() {
    if [ "$HSB_SENDER_ENABLED" != 1 ]; then
        echo "h15-hsb-sender is disabled in /etc/default/h15-hsb-sender"
        return 0
    fi
    if is_running; then
        echo "h15-hsb-sender is already running"
        return 0
    fi
    echo "Starting h15-hsb-sender..."
    ensure_broadcast
    # The media library configuration lives in /run, which is empty after every boot.
    config_output=$($MAKE_CONFIG $HSB_MAKE_CONFIG_OPTS 2>&1)
    config_status=$?
    echo "$config_output" | logger -t $LOG_TAG
    if [ $config_status -ne 0 ]; then
        echo "h15-hsb-make-config failed: $config_output"
        return 1
    fi
    start-stop-daemon --start --quiet --background --make-pidfile --pidfile $PIDFILE \
        --startas /bin/sh -- -c "while true; do \
            { $DAEMON --interface $HSB_INTERFACE $HSB_SENDER_OPTS; echo \"exited with status \$?\"; } \
                2>&1 | logger -t $LOG_TAG; \
            sleep $RESPAWN_DELAY; \
        done"
}

stop() {
    echo "Stopping h15-hsb-sender..."
    # Stop the respawn loop first so it cannot start the sender again.
    if is_running; then
        kill "$(cat $PIDFILE)"
    fi
    rm -f $PIDFILE
    sender_pids=$(pidof h15-hsb-sender) || return 0
    kill -TERM $sender_pids
    if ! wait_for_sender_exit; then
        echo "h15-hsb-sender did not stop within ${STOP_TIMEOUT}s; killing it"
        kill -KILL $(pidof h15-hsb-sender) 2>/dev/null
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    status)
        status $DAEMON
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
